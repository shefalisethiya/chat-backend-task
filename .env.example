NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/chat_backend
# Optional if not using DATABASE_URL:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=chat_backend
# PGUSER=postgres
# PGPASSWORD=your_password

# Option A: path to Firebase service-account JSON file (never commit it)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B: base64-encoded service-account JSON. Use this in deployment environments.
# FIREBASE_SERVICE_ACCOUNT_BASE64=
